<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario para leer el sensor de pasos (Android 10+) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Notificación del descanso entre series (Android 13+ la pide al usuario) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibrar al terminar el descanso -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Avisar justo al terminar el descanso aunque la app esté cerrada ("Alarmas y recordatorios") -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".EjercicioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ejercicio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Ejercicio.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe la alarma de fin de descanso (no se expone a otras apps) -->
        <receiver
            android:name=".data.timer.RestTimerReceiver"
            android:exported="false" />

        <!--
            WorkManager se configura en EjercicioApplication (con HiltWorkerFactory),
            así que se desactiva su inicialización automática.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>